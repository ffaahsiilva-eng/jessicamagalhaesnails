{
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "*/10 10-23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/wapi/:match*",
      "destination": "https://api.w-api.app/:match*"
    },
    {
      "source": "/((?!api/|media/|assets/|sw.js|workbox-|manifest).*)",
      "destination": "/index.html"
    }
  ]
}
